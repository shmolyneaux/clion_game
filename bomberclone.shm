            window_h - (button_height+padding_y)*(self.labels.len()-1)
        )/2

        let hovered_idx = None
        for idx, label in self.labels.enumerate() {
            let y = button_center_start+idx*(button_height+padding_y)
            let color = if idx == self.selected_idx { BUTTON_FOCUS_COLOR } else { BUTTON_COLOR }
            Button(
                x,
                y,
                button_width,
                button_height,
                label=label,
                color=color,
                center=true,
            ).draw()
        }
        if hovered_idx != None {
            draw_rect(
                x - button_width/2 - 15,
                button_center_start+hovered_idx*(button_height+padding_y),
                w=10,
                h=10,
                center=true
            )
        }
    }

    fn reset(self) {
        self.selected_idx = 0
    }
}

let HORIZONTAL = 0
let VERTICAL = 1

let NORTH = 0
let EAST = 1
let SOUTH = 2
let WEST = 3

fn move(distance, primary, secondary) {
    let delta = secondary % TILE_SIZE
    if delta == 0 {
        primary -= distance
    } else {
        if delta < TILE_SIZE/2 {
            if delta > distance {
                secondary -= distance
            } else {
                secondary -= delta
                distance -= delta
                secondary -= distance
            }
        } else {
            delta = TILE_SIZE - delta
            if delta > distance {
                secondary += distance
            } else {
                secondary += delta
                distance -= delta
                primary -= distance
            }
        }
    }

    (primary, secondary)
}

struct KeyTracker {
    keys_to_track={
        let s = set()
        for k in [key.Up, key.Down, key.Left, key.Right] {
            s.add(k.scan_code)
        }
        s
    }
    keys_down=set()
    fn tick(self) {
        for scan_code in self.keys_to_track {
            if key_from_scan_code(scan_code).pressed {
                self.keys_down.add(scan_code)
            } else {
                self.keys_down.discard(scan_code)
            }
        }
    }
}

struct Player {
    x=window_w/2
    y=window_h/2
    facing = EAST

    fn tick(self) {
        let arrows = [key.Up.scan_code, key.Down.scan_code, key.Left.scan_code, key.Right.scan_code]
        let keys_down = list(key_tracker.keys_down).filter(fn(code) {code in arrows})

        //self.x = 50
        //self.y = 50

        let remaining = 5
        if keys_down {
            let priority = keys_down[-1]
            if priority == key.Up.scan_code {
                let (y, x) = move(remaining, self.y, self.x)
                self.x = x
                self.y = y
            }
            if priority == key.Down.scan_code {
                let (y, x) = move(remaining, self.y, self.x)
                self.x = x
                self.y += self.y - y
            }
            if priority == key.Left.scan_code {
                let (x, y) = move(remaining, self.x, self.y)
                self.x = x
                self.y = y
            }
            if priority == key.Right.scan_code {
                let (x, y) = move(remaining, self.x, self.y)
                self.x += self.x - x
                self.y = y
            }
        }
    }

    fn draw(self) {
        draw_rect(self.x, self.y, TILE_SIZE, TILE_SIZE, g=0, r=0)
    }
}

let ROW_COUNT = 16
let COLUMN_COUNT = 16

let TILE_SIZE = 64
let GRID_WIDTH = 4

struct Game {
    players = [Player()]

    fn tick(self) {
        if key.Escape.pressed {
            scene = main_menu
            main_menu.reset()
            return
        }

        for player in self.players {
            player.tick()
        }
    }

    fn draw(self) {
        for row in 0..ROW_COUNT {
            draw_rect(TILE_SIZE/2, (row+0.5)*TILE_SIZE-GRID_WIDTH/2, COLUMN_COUNT*TILE_SIZE-TILE_SIZE+GRID_WIDTH/2, GRID_WIDTH, r=0.9, g=0.9, b=0.2)
        }

        for col in 0..COLUMN_COUNT {
            draw_rect((col+0.5)*TILE_SIZE-GRID_WIDTH/2, TILE_SIZE/2, GRID_WIDTH, ROW_COUNT*TILE_SIZE-TILE_SIZE+GRID_WIDTH/2, r=0.9, g=0.9, b=0.2)
        }

        for player in self.players {
            player.draw()
        }
    }

    fn reset(self) {
        self.players = Game().players
    }
}

struct TextureData {
    w
    h
    data
    nearest=true
    __check=assert(w*h*4 == data.len())

    fn create_texture(self) {
        create_texture(
            self.w,
            self.h,
            self.data,
            nearest=self.nearest,
        )
    }
}

// TODO: Some sort of eviction?
let texture_data_cache = {}
let texture_cache = {}

fn get_texture_data(name) {
    if name in texture_data_cache {
        texture_data_cache.get(name)
    } else {
        let tex_data = load_data(
            TextureData,
            "texture/\(name)",
            default_fn=fn() {
                let w = 16
                let h = 16
                let data = []
                for _ in w*h {
                    data.append(1.0)
                    data.append(1.0)
                    data.append(1.0)
                    data.append(1.0)
                }
                TextureData(w, h, data)
            }
        )
        texture_data_cache[name] = tex_data
        tex_data
    }
}

fn get_texture(name) {
    if name in texture_cache {
        texture_cache.get(name)
    } else {
        let tex_data = get_texture_data(name)
        let tex = create_texture(
            tex_data.w,
            tex_data.h,
            tex_data.data,
            nearest=tex_data.nearest,
        )
        texture_cache[name] = tex
        tex
    }
}

struct EditableTexture {
    data={
        let w = 16
        let h = 16
        let data = []
        for _ in 0..w*h {
            data.append(1.0)
            data.append(1.0)
            data.append(1.0)
            data.append(1.0)
        }
        TextureData(w, h, data)
    }
    texture=create_texture(data.w, data.h, data.data, nearest=data.nearest)

    fn set(self, x, y, c) {
        if 0 <= x < self.data.w and 0 <= y < self.data.h {
            self.data.data[x*4+y*self.data.w*4+0] = c[0]
            self.data.data[x*4+y*self.data.w*4+1] = c[1]
            self.data.data[x*4+y*self.data.w*4+2] = c[2]
            self.data.data[x*4+y*self.data.w*4+3] = c[3]
            self.texture = create_texture(
                self.data.w,
                self.data.h,
                self.data.data,
                nearest=self.data.nearest,
            )
        } else {
            debug_log("\((x, y)) outside of bounds \((self.data.w, self.data.h))")
        }
    }
}

struct CallbackButton {
    btn
    callback

    fn tick(self) {
        if self.btn.just_pressed() {
            self.callback()
        }
    }

    fn draw(self) {
        self.btn.draw()
    }
}

struct TextureEditorUI {
    editor=TextureEditor()
    new_texture_btn=CallbackButton(
        Button(
            50,
            300,
            60,
            60,
            "New Texture",
            color=(200, 0, 0),
            hover_color=(100, 0, 0),
        ),
        callback=fn() {}
    )
    initialized=false

    fn reset(self) {
        self.editor.reset()
    }

    fn tick(self) {
        if key.Escape.just_pressed {
            scene = main_menu
            scene.reset()
        }

        if !self.initialized {
            self.new_texture_btn.callback = fn() {
                editor.texture = EditableTexture()
                debug_log("callback button pressed")
            }
            self.initialized = true
            debug_log("ui inited")
        }

        self.editor.tick()
        self.new_texture_btn.tick()
        draw_text(
            100,
            100,
            "test",
        )
    }

    fn draw(self) {
        self.editor.draw()
        self.new_texture_btn.draw()
    }
}

struct TextureEditor {
    current_color=(255, 0, 0, 255)
    texture=None // EditableTexture
    texture_list=[]
    zoom=6.0

    fn reset(self) {
        self.texture = EditableTexture()
    }

    fn tick(self) {
        self.zoom = 16
    }

    fn draw(self) {
        if self.texture == None {
            let text = "No Texture Loaded"
            draw_text(
                window_w/2,
                window_h/2,
                text,
                size=2.0,
                center=true,
            )
        } else {
            let x = window_w/2-self.texture.data.w*self.zoom/2
            let y = window_h/2-self.texture.data.h*self.zoom/2
            draw_rect(
                x,
                y,
                self.texture.data.w*self.zoom,
                self.texture.data.h*self.zoom,
                texture=self.texture.texture,
            )
            // Texture coordinates
            let tx = ((mouse_x - x)/self.zoom).round()
            let ty = ((mouse_y - y)/self.zoom).round()
            draw_rect(
                x+tx*self.zoom,
                y+ty*self.zoom,
                self.zoom,
                self.zoom,
                r=255,
                g=0,
                b=255,
            )
            if mouse_just_pressed(MOUSE_LEFT) and 0 <= tx < self.texture.data.w and 0 <= ty < self.texture.data.h{
                self.texture.set(tx, ty, (255, 0, 255, 255))
            }
        }
    }
}

let checkerboard = {
    let width = 16
    let height = 16
    let checkerboard_data = []
    let light = (200, 200, 200, 255)
    let dark = (100, 100, 100, 255)
    for y in 0..height {
        for x in 0..width {
            let color = if (x+y) % 2 == 0 {light} else {dark}
            checkerboard_data.append(color[0])
            checkerboard_data.append(color[1])
            checkerboard_data.append(color[2])
            checkerboard_data.append(color[3])
        }
    }
    create_texture(width, height, checkerboard_data, nearest=true)
}

