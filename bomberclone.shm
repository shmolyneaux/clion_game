fn in_rect(pos, x, y, w, h, center=false) {
    if center {
        x = x - w/2
        y = y - h/2
    }

    x <= pos[0] < x+w and y <= pos[1] < y+h
}

struct Button {
    x
    y
    w
    h
    label
    color=(1.0, 1.0, 1.0)
    hover_color={
        (color[0]*0.8, color[1]*0.8, color[2]*0.8)
    }
    center=false

    fn hovered(self) {
        self.h=40
        draw_text(
            30,
            200,
            "\(self.x) \(mouse_x) \(self.x+self.w)\n\(self.y) \(mouse_y) \(self.y+self.h)",
        )
        self.x <= mouse_x < self.x+self.w and
        self.y <= mouse_y < self.y+self.h
    }

    fn just_pressed(self) {
        self.hovered() and mouse_just_pressed(MOUSE_LEFT)
    }

    fn draw(self) {
        let color = if self.hovered() { self.hover_color } else { self.color }
        draw_rect(
            self.x,
            self.y,
            self.w,
            self.h,
            r=color[0],
            g=color[1],
            b=color[2],
        )
        draw_text(
            self.x+self.w/2,
            self.y+self.h/2,
            "\(self.label)",
            // TODO: centering
            center=true,
        )
    }
}

let BUTTON_COLOR = (1.0, 0.5, 0.5)
let BUTTON_FOCUS_COLOR = (0.8, 0.5, 0.5)

struct PlayLabel { fn format(self) { "Play" } }
struct OptionsLabel { fn format(self) { "Options" } }
struct CreditsLabel { fn format(self) { "Credits" } }
struct TextureEditorLabel { fn format(self) { "Texture Editor" } }

struct MainMenu {
    selected_idx=0
    labels = [PlayLabel(), OptionsLabel(), CreditsLabel(), TextureEditorLabel()]

    fn tick(self) {
        if key.Down.just_pressed_with_repeat {
            self.selected_idx += 1
        }
        if key.Up.just_pressed_with_repeat{
            self.selected_idx -= 1
        }

        self.selected_idx %= self.labels.len()

        if key.Enter.just_pressed {
            let button = self.labels[self.selected_idx]
            if button.__type__ == PlayLabel {
                scene = game
                scene.reset()
            }
            if button.__type__ == OptionsLabel {
                scene = options_menu
                scene.reset()
            }
            if button.__type__ == TextureEditorLabel {
                scene = texture_editor
                scene.reset()
            }
        }
    }

    fn draw(self) {
        let x = window_w/2
        let padding_y = 10
        let button_height = 50
        let button_width = 120

        let button_center_start = (
            window_h - (button_height+padding_y)*(self.labels.len()-1)
        )/2

        let hovered_idx = None
        for idx, label in self.labels.enumerate() {
            let y = button_center_start+idx*(button_height+padding_y)
            let color = if idx == self.selected_idx { BUTTON_FOCUS_COLOR } else { BUTTON_COLOR }
            Button(
                x,
                y,
                button_width,
                button_height,
                label=label,
                color=color,
                center=true,
            ).draw()
        }
        if hovered_idx != None {
            draw_rect(
                x - button_width/2 - 15,
                button_center_start+hovered_idx*(button_height+padding_y),
                w=10,
                h=10,
                center=true
            )
        }
    }

    fn reset(self) {
        self.selected_idx = 0
    }
}

fn clear_screen() {
    draw_rect(0, 0, window_w, window_h, r=0.5, g=0.5, b=0.5)
}

let foo = "testing";
let tick_count = 0

let window_w = 0
let window_h = 0

let mouse_x = 0
let mouse_y = 0

struct MouseInput {}
struct KeyboardInput {}

let input_display = None

let debug_lines = []

struct DebugMessage {
    text=text
    tick=tick_count
}

fn debug_log(msg) {
    let msg = DebugMessage("\(msg)")
    debug_lines.append(msg)
}

let tick_fns = []
fn add_tick_fn(func) {
    tick_fns.append(func)
}

fn remove_tick_fn(func_to_remove) {
    let idx_to_remove = None
    for idx, func in tick_fns {
        if func == func_to_remove {
            idx_to_remove = idx
            break
        }
    }
    if idx_to_remove != None {
        tick_fns.pop(idx_to_remove)
    }
}

fn draw_console() {
    let msg_idx = debug_lines.len() - 1
    let line_height = 8
    let margin = 5

    let pixels_remaining = line_height*10
    let message_spacing = 5
    let gutter = 60

    draw_rect(
        0,
        0,
        window_w,
        2*margin+pixels_remaining,
        r=0.0,
        g=0.0,
        b=0.0,
        a=0.2,
    )

    while msg_idx >= 0 and pixels_remaining > 0 {
        let msg = debug_lines[msg_idx]
        let lines = msg.text.split_lines()
        pixels_remaining -= lines.len()*line_height
        draw_text(
            margin,
            margin+pixels_remaining,
            msg.tick,
        )
        for idx, line in lines.enumerate() {
            draw_text(
                margin+gutter,
                margin+pixels_remaining + idx*line_height,
                line,
            )
        }
        pixels_remaining -= message_spacing
        msg_idx -= 1
    }
}

